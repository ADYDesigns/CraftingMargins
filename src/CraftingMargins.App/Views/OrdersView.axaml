<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CraftingMargins.App.ViewModels"
             xmlns:core="using:CraftingMargins.Core"
             xmlns:local="using:CraftingMargins.App"
             x:Class="CraftingMargins.App.Views.OrdersView"
             x:DataType="vm:MainViewModel">
  <DockPanel Margin="8,16,8,16" DataContext="{Binding Orders}" x:DataType="vm:OrdersViewModel">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
      <TextBlock Classes="pageTitle" Text="Orders"/>
      <TextBlock Classes="pageSub" Text="What each order really earned. Etsy orders show a profit once their money is on a statement you've imported."/>
    </StackPanel>
    <TabControl Classes="sub" SelectedIndex="{Binding SelectedSubTab}" Padding="0,8,0,0">
      <TabItem Header="All orders">
        <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,16,330">
          <DockPanel Grid.ColumnSpan="3" Margin="0,0,0,10">
            <TextBox DockPanel.Dock="Left" Width="300" PlaceholderText="Search order, item or note" Text="{Binding Filter}"/>
            <TextBlock Margin="16,0" VerticalAlignment="Center" Text="{Binding Summary}" Classes="muted"/>
          </DockPanel>
          <DataGrid AutomationProperties.Name="Orders" Grid.Row="1" ItemsSource="{Binding Orders}" SelectedItem="{Binding Selected}" IsReadOnly="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Sold" Binding="{Binding SaleDate, StringFormat='{}{0:MMM d, yyyy}'}" SortMemberPath="SaleDate" Width="115"/>
              <DataGridTextColumn Header="Items" Binding="{Binding Items}" Width="*" MinWidth="240"/>
              <DataGridTemplateColumn Header="" Width="52">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="core:OrderProfit">
                    <Border Classes="pill" Margin="6,0" Background="{DynamicResource BrandLightBrush}" IsVisible="{Binding AdAttributed}"
                            ToolTip.Tip="This sale came through an Offsite Ad">
                      <TextBlock FontSize="11" FontWeight="SemiBold" Text="Ad" Foreground="{DynamicResource BrandTextBrush}"/>
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Profit" SortMemberPath="ProfitIfKnown" Width="95">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="core:OrderProfit">
                    <TextBlock Margin="10,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"
                               Text="{Binding ProfitIfKnown, StringFormat=N2}" Foreground="{Binding ProfitIfKnown, Converter={x:Static vm:Converters.NegativeRed}}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Price" Binding="{Binding ItemPrice, StringFormat=N2}" CellStyleClasses="num" Width="90"/>
              <DataGridTextColumn Header="Fees" Binding="{Binding EtsyFees, StringFormat=N2}" CellStyleClasses="num" Width="85"/>
              <DataGridTextColumn Header="Label" Binding="{Binding Label, StringFormat=N2}" CellStyleClasses="num" Width="85"/>
              <DataGridTextColumn Header="Costs" Binding="{Binding Costs, StringFormat=N2}" CellStyleClasses="num" Width="85"/>
            </DataGrid.Columns>
          </DataGrid>

          <!-- The selected order, line by line -->
          <Border Grid.Row="1" Grid.Column="2" Classes="card" Padding="16,12" VerticalAlignment="Top">
            <StackPanel Spacing="8">
              <StackPanel>
                <TextBlock Classes="h2" Text="{Binding SelectedTitle}"/>
                <TextBlock Classes="hint" Margin="0" TextWrapping="Wrap" Text="{Binding SelectedNote}"/>
              </StackPanel>
              <ItemsControl ItemsSource="{Binding SelectedLines}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CalcLine">
                    <Grid ColumnDefinitions="*,90" Margin="0,2">
                      <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="{Binding Bold, Converter={x:Static vm:Converters.BoldIfTrue}}"/>
                      <TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="{Binding Amount, StringFormat=N2}"
                                 FontWeight="{Binding Bold, Converter={x:Static vm:Converters.BoldIfTrue}}" Foreground="{Binding Amount, Converter={x:Static vm:Converters.NegativeRed}}"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Spacing="8" IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,4"/>
                <TextBlock Classes="label" Margin="0" Text="Shipping paid outside Etsy"/>
                <TextBlock Classes="hint" Margin="0" TextWrapping="Wrap" Text="A label you bought somewhere else (e.g. Pirate Ship) for this order."/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBox Width="100" Text="{Binding ExtraShipping}" PlaceholderText="0.00"/>
                  <Button Classes="primary" Content="Save" Command="{Binding SaveExtraShippingCommand}"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="Sales outside Etsy">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="hint" Margin="0,0,0,4" TextWrapping="Wrap"
                     Text="Craft fairs, markets, friends and family: anything you sold without Etsy. Each row is one sale. Pick the Etsy listing it matches so its cost rules apply, or type a new item name and give it rules in Products &amp; Costs. Dates are yyyy-mm-dd. Price is per item; Shipping is what the buyer paid; Fees are the card reader or market fees; Postage is what you paid to send it. Options use the same form as Etsy, e.g. Size:Large,Color:White."/>
          <StackPanel DockPanel.Dock="Top" Classes="buttons">
            <Button Content="Add sale" Command="{Binding AddOtherSaleCommand}"/>
            <Button Classes="danger" Content="Delete sale" Command="{Binding DeleteOtherSaleCommand}"/>
            <Button Classes="primary" Content="Save sales" Command="{Binding SaveOtherSalesCommand}"/>
            <TextBlock Classes="unsaved" IsVisible="{Binding OtherSalesEdit.IsDirty}"/>
            <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding OtherSummary}"/>
          </StackPanel>
          <DataGrid AutomationProperties.Name="Sales outside Etsy" ItemsSource="{Binding OtherSales}" SelectedItem="{Binding SelectedOtherSale}" RowHeight="40" CanUserSortColumns="False">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Date" Width="160">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:OtherSaleRow">
                    <CalendarDatePicker Classes="cell" SelectedDate="{Binding Date, Converter={x:Static vm:Converters.DateText}}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Where" Binding="{Binding Channel}" Width="140"/>
              <DataGridTemplateColumn Header="Item" Width="300">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="vm:OtherSaleRow">
                    <AutoCompleteBox ItemsSource="{Binding ItemOptions}" Text="{Binding Item}" FilterMode="ContainsOrdinal" MinimumPrefixLength="0" Margin="4,0"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Options" Binding="{Binding Options}" Width="200"/>
              <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" CellStyleClasses="num" Width="80"/>
              <DataGridTextColumn Header="Price" Binding="{Binding Price}" CellStyleClasses="num" Width="95"/>
              <DataGridTextColumn Header="Shipping" Binding="{Binding Shipping}" CellStyleClasses="num" Width="115"/>
              <DataGridTextColumn Header="Fees" Binding="{Binding Fees}" CellStyleClasses="num" Width="90"/>
              <DataGridTextColumn Header="Postage" Binding="{Binding Postage}" CellStyleClasses="num" Width="110"/>
              <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*" MinWidth="160"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
