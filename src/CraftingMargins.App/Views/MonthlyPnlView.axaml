<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CraftingMargins.App.ViewModels"
             xmlns:core="using:CraftingMargins.Core"
             xmlns:local="using:CraftingMargins.App"
             x:Class="CraftingMargins.App.Views.MonthlyPnlView"
             x:DataType="vm:MainViewModel">
  <ScrollViewer>
  <Grid RowDefinitions="Auto,Auto,Auto" Margin="8,16,8,16" DataContext="{Binding Pnl}" x:DataType="vm:PnlViewModel">
    <!-- One page scroll: the month list has a set height so it doesn't jump; the cards below show in full. -->
    <StackPanel Margin="0,0,0,12">
      <TextBlock Classes="pageTitle" Text="Monthly profit and loss"/>
      <TextBlock Classes="pageSub" Text="What came in and went out each month, from your statements. The dot is the self-test: green adds up to the penny. Pick a month to see everything that made it up."/>
    </StackPanel>
    <DataGrid AutomationProperties.Name="Monthly profit and loss" Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" IsReadOnly="True" CanUserSortColumns="False" Height="380">
      <DataGrid.Styles>
        <Style Selector="DataGridRow">
          <Setter Property="FontWeight" Value="{ReflectionBinding IsTotal, Converter={x:Static vm:Converters.BoldIfTrue}}"/>
        </Style>
      </DataGrid.Styles>
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="" Width="34">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:PnlRow">
              <Ellipse Classes="dot" HorizontalAlignment="Center" Fill="{Binding Passed, Converter={x:Static vm:Converters.GoodBad}}"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Month" Binding="{Binding Label}" Width="150"/>
        <DataGridTemplateColumn Header="Net profit" Width="120">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:PnlRow">
              <TextBlock Margin="10,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"
                         Text="{Binding NetProfit, StringFormat=N2}" Foreground="{Binding NetProfit, Converter={x:Static vm:Converters.NegativeRed}}"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Margin" Binding="{Binding Margin, StringFormat={}{0:0%}}" CellStyleClasses="num" Width="105"/>
        <DataGridTextColumn Header="Orders" Binding="{Binding Orders}" CellStyleClasses="num" Width="100"/>
        <DataGridTextColumn Header="Sales" Binding="{Binding NetSales, StringFormat=N2}" CellStyleClasses="num" Width="120"/>
        <DataGridTextColumn Header="Refunds" Binding="{Binding Refunds, StringFormat=N2}" CellStyleClasses="num" Width="105"/>
        <DataGridTextColumn Header="Etsy fees" Binding="{Binding EtsyFees, StringFormat=N2}" CellStyleClasses="num" Width="115"/>
        <DataGridTextColumn Header="Shipping" Binding="{Binding Shipping, StringFormat=N2}" CellStyleClasses="num" Width="115"/>
        <DataGridTextColumn Header="Making costs" Binding="{Binding Costs, StringFormat=N2}" CellStyleClasses="num" Width="140"/>
        <DataGridTextColumn Header="Outside Etsy" Binding="{Binding OutsideEtsy, StringFormat=N2}" CellStyleClasses="num" Width="*" MinWidth="120"/>
      </DataGrid.Columns>
    </DataGrid>

    <!-- The selected month, line by line, and its self-test -->
    <Grid Grid.Row="2" ColumnDefinitions="270,16,*,16,*" Margin="0,12,0,0">
      <!-- Where the month's money went -->
      <Border Classes="card" Padding="16,12">
        <StackPanel Spacing="6">
          <TextBlock Classes="h2" Text="Where the money went"/>
          <local:DonutChart Height="130" Slices="{Binding SelectedSplit.Slices}" CenterText="{Binding SelectedSplit.Center}"
                            CenterSubText="{Binding SelectedSplit.CenterSub}" CenterBad="{Binding SelectedSplit.IsLoss}"/>
          <ItemsControl ItemsSource="{Binding SelectedSplit.Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SplitRow">
                <Grid ColumnDefinitions="18,*,Auto,42" Margin="0,1">
                  <Border Width="11" Height="11" CornerRadius="2" Background="{Binding Color}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12"/>
                  <TextBlock Grid.Column="2" Text="{Binding Amount}" FontSize="12" HorizontalAlignment="Right"/>
                  <TextBlock Grid.Column="3" Text="{Binding Share}" FontSize="12" HorizontalAlignment="Right" Foreground="{DynamicResource MutedBrush}"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Classes="card" Padding="16,12">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="h2" Margin="0,0,0,6" Text="{Binding SelectedTitle}"/>
          <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,6,0,0" Margin="0,6,0,0">
            <Grid ColumnDefinitions="*,110">
              <TextBlock FontWeight="SemiBold" Text="Net profit"/>
              <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding SelectedNetProfit, StringFormat=N2}"
                         Foreground="{Binding SelectedNetProfit, Converter={x:Static vm:Converters.NegativeRed}}"/>
            </Grid>
          </Border>
            <ItemsControl ItemsSource="{Binding SelectedLines}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CalcLine">
                  <Grid ColumnDefinitions="*,110" Margin="0,2">
                    <TextBlock Text="{Binding Name}" FontWeight="{Binding Bold, Converter={x:Static vm:Converters.BoldIfTrue}}"/>
                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="{Binding Amount, StringFormat=N2}"
                               FontWeight="{Binding Bold, Converter={x:Static vm:Converters.BoldIfTrue}}" Foreground="{Binding Amount, Converter={x:Static vm:Converters.NegativeRed}}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
      </Border>
      <Border Grid.Column="4" Classes="card" Padding="16,12">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="0,0,0,8">
            <Ellipse Width="14" Height="14" Margin="0,3,10,0" VerticalAlignment="Top" Fill="{Binding Selected.Passed, Converter={x:Static vm:Converters.GoodBad}}"/>
            <StackPanel Grid.Column="1">
              <TextBlock Classes="h2" Text="Self-test"/>
              <TextBlock TextWrapping="Wrap" Text="{Binding SelectedVerdict}"/>
            </StackPanel>
          </Grid>
            <ItemsControl ItemsSource="{Binding SelectedIssues}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,3" Foreground="{DynamicResource MutedBrush}"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
  </ScrollViewer>
</UserControl>
