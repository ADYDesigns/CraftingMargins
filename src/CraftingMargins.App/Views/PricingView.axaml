<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CraftingMargins.App.ViewModels"
             xmlns:core="using:CraftingMargins.Core"
             xmlns:local="using:CraftingMargins.App"
             x:Class="CraftingMargins.App.Views.PricingView"
             x:DataType="vm:MainViewModel">
  <DockPanel Margin="8,16,8,16" DataContext="{Binding Pricing}" x:DataType="vm:PricingViewModel">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
      <Button DockPanel.Dock="Right" VerticalAlignment="Top" Content="Export to Excel…" Command="{Binding ExportCommand}"/>
      <StackPanel>
        <TextBlock Classes="pageTitle" Text="Pricing"/>
        <TextBlock Classes="pageSub" TextWrapping="Wrap" Text="What one unit of each option earns at today's price: organic, and in the worst case (the sale came through an Offsite Ad). Red = below your profit goal (Settings)."/>
      </StackPanel>
    </DockPanel>
    <Border DockPanel.Dock="Top" Classes="bar" Margin="0,4,0,4" IsVisible="{Binding PricesMayBeStale}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="primary" Content="Sync with Etsy now" Command="{Binding RefreshPricesCommand}"/>
        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="These prices came from Etsy more than 6 hours ago and may have changed."/>
      </DockPanel>
    </Border>
    <TabControl Classes="sub" SelectedIndex="{Binding SelectedSubTab}" Padding="0,8,0,0">

      <TabItem Header="Pricing check">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
          <StackPanel Spacing="2" Margin="0,0,0,8">
            <TextBlock FontWeight="SemiBold" Text="{Binding Summary}" TextWrapping="Wrap"/>
            <TextBlock Classes="hint" Margin="0" Text="{Binding SourceText}" TextWrapping="Wrap"/>
          </StackPanel>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16" Margin="0,0,0,8">
            <TextBox Width="300" PlaceholderText="Search listing or option" Text="{Binding Filter}"/>
            <CheckBox IsChecked="{Binding OnlyProblems}" Content="Only options below the goal or without a cost"/>
          </StackPanel>
          <DataGrid AutomationProperties.Name="Pricing check" Grid.Row="2" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" IsReadOnly="True">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="" Width="34">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="core:PriceRow">
                    <Ellipse Classes="dot" HorizontalAlignment="Center" Fill="{Binding Ok, Converter={x:Static vm:Converters.GoodBad}}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Listing" Binding="{Binding Title}" Width="250"/>
              <DataGridTextColumn Header="Options" Binding="{Binding OptionsText}" Width="250"/>
              <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=N2}" CellStyleClasses="num"/>
              <DataGridTemplateColumn Header="Worst case" SortMemberPath="WorstCase">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="core:PriceRow">
                    <TextBlock Margin="10,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"
                               Text="{Binding WorstCase, StringFormat=N2}" Foreground="{Binding BelowFloor, Converter={x:Static vm:Converters.RedIfTrue}}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Organic" Binding="{Binding Organic, StringFormat=N2}" CellStyleClasses="num"/>
              <DataGridTextColumn Header="Lowest price for goal" Binding="{Binding MinPrice, StringFormat=N2}" CellStyleClasses="num"/>
              <DataGridTextColumn Header="Cost" Binding="{Binding Cost, StringFormat=N2}" CellStyleClasses="num"/>
              <DataGridTextColumn Header="Shipping" Binding="{Binding Shipping, StringFormat=N2}" CellStyleClasses="num"/>
              <DataGridTextColumn Header="Label" Binding="{Binding Label, StringFormat=N2}" CellStyleClasses="num"/>
              <DataGridTextColumn Header="Making hours" Binding="{Binding MakingHours, StringFormat=0.##}" CellStyleClasses="num"/>
              <DataGridTextColumn Header="$ per making hour" Binding="{Binding OrganicPerHour, StringFormat=N2}" CellStyleClasses="num"/>
              <DataGridTextColumn Header="Worst $ per making hour" Binding="{Binding WorstPerHour, StringFormat=N2}" CellStyleClasses="num"/>
              <DataGridTextColumn Header="Status" Binding="{Binding Status}" Foreground="{DynamicResource MutedBrush}"/>
              <DataGridTextColumn Header="Price from" Binding="{Binding PriceSource}" Foreground="{DynamicResource MutedBrush}"/>
              <DataGridTextColumn Header="Label from" Binding="{Binding LabelSource}" Foreground="{DynamicResource MutedBrush}"/>
            </DataGrid.Columns>
          </DataGrid>
          <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="Open this listing's cost rules" Command="{Binding GoToRulesCommand}"/>
            <TextBlock Classes="hint" Margin="0,0,16,0" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="One unit, today's fee rates and costs, packaging included. Shipping = what buyers typically paid on single-item orders; label = the typical matched label (or equal to shipping). Leaves out the 3% processing fee on sales tax (about 12¢ on $4 of tax), which depends on where the buyer lives."/>
          </DockPanel>
        </Grid>
      </TabItem>

      <TabItem Header="Planned sale">
        <Grid ColumnDefinitions="300,16,*">
          <Border Classes="card" Padding="10">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
                <TextBlock Classes="label" Text="Percent off"/>
                <NumericUpDown Value="{Binding SalePercent}" Minimum="0" Maximum="90" Increment="5" FormatString="0" Width="140" HorizontalAlignment="Left"/>
                <TextBlock Classes="label" Text="Listings in the sale"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="link" Padding="0" Content="All" Command="{Binding SelectAllForSaleCommand}"/>
                  <Button Classes="link" Padding="0" Content="None" Command="{Binding SelectNoneForSaleCommand}"/>
                </StackPanel>
              </StackPanel>
              <ListBox AutomationProperties.Name="Listings in the planned sale" ItemsSource="{Binding SaleListings}" BorderThickness="0" Padding="0">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:SaleListingRow">
                    <CheckBox IsChecked="{Binding IsSelected}">
                      <TextBlock TextWrapping="Wrap"><Run Text="{Binding Title}"/><Run Text="  ("/><Run Text="{Binding Options}"/><Run Text=")"/></TextBlock>
                    </CheckBox>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Border>
          <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,8" Text="{Binding SaleSummary}" TextWrapping="Wrap"/>
            <TextBlock DockPanel.Dock="Bottom" Classes="hint" Margin="0,8,0,0" TextWrapping="Wrap" Text="Etsy takes its fees on the sale price, and the Offsite Ads fee is still charged on ad sales during a sale. Shipping isn't discounted here."/>
            <DataGrid AutomationProperties.Name="Planned sale preview" ItemsSource="{Binding SaleRows}" IsReadOnly="True">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="34">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate x:DataType="core:PriceRow">
                    <Ellipse Classes="dot" HorizontalAlignment="Center" Fill="{Binding Ok, Converter={x:Static vm:Converters.GoodBad}}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Listing" Binding="{Binding Title}" Width="230"/>
                <DataGridTextColumn Header="Options" Binding="{Binding OptionsText}" Width="230"/>
                <DataGridTextColumn Header="Now" Binding="{Binding ListPrice, StringFormat=N2}" CellStyleClasses="num"/>
                <DataGridTextColumn Header="Sale price" Binding="{Binding Price, StringFormat=N2}" CellStyleClasses="num"/>
                <DataGridTemplateColumn Header="Worst case" SortMemberPath="WorstCase">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="core:PriceRow">
                      <TextBlock Margin="10,0" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"
                                 Text="{Binding WorstCase, StringFormat=N2}" Foreground="{Binding BelowFloor, Converter={x:Static vm:Converters.RedIfTrue}}"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Organic" Binding="{Binding Organic, StringFormat=N2}" CellStyleClasses="num"/>
                <DataGridTextColumn Header="Cost" Binding="{Binding Cost, StringFormat=N2}" CellStyleClasses="num"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Foreground="{DynamicResource MutedBrush}"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Grid>
      </TabItem>
    <TabItem Header="Price calculator">
        <ScrollViewer>
          <Grid ColumnDefinitions="460,24,*" Margin="0,0,8,8">
            <!-- Inputs -->
            <Border Classes="card" VerticalAlignment="Top">
              <StackPanel Spacing="12">
                <TextBlock Classes="h2" Text="A product you're thinking of listing"/>
                <Grid ColumnDefinitions="200,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                  <TextBlock VerticalAlignment="Center" Text="Price"/>
                  <NumericUpDown Grid.Column="1" Value="{Binding CalcPrice}" Minimum="0" Increment="1" FormatString="0.00" Width="160" HorizontalAlignment="Left"/>
                  <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Shipping the buyer pays"/>
                  <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding CalcShipping}" Minimum="0" Increment="0.5" FormatString="0.00" Width="160" HorizontalAlignment="Left"/>
                  <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Label cost (blank = same)"/>
                  <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CalcLabel}" Width="160" HorizontalAlignment="Left" PlaceholderText="same as shipping"/>
                  <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Other cost per unit"/>
                  <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding CalcExtraCost}" Minimum="0" Increment="0.25" FormatString="0.00" Width="160" HorizontalAlignment="Left"/>
                </Grid>
                <CheckBox IsChecked="{Binding CalcPackaging}" Content="Add my packaging cost (Settings)"/>
                <TextBlock FontWeight="SemiBold" Text="Parts it uses (optional)"/>
                <DataGrid AutomationProperties.Name="Parts in the price calculator" ItemsSource="{Binding CalcParts}" SelectedItem="{Binding SelectedCalcPart}" MaxHeight="220" CanUserSortColumns="False" RowHeight="42">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Part" Width="270">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:CalcPartRow">
                          <ComboBox ItemsSource="{Binding PartOptions}" SelectedItem="{Binding Part}" HorizontalAlignment="Stretch" Margin="4,0"/>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="How many" Width="130">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:CalcPartRow">
                          <NumericUpDown Value="{Binding Count}" Minimum="0" Increment="1" FormatString="0.##" Margin="4,0"/>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
                <StackPanel Classes="buttons" Margin="0">
                  <Button Content="Add part" Command="{Binding AddCalcPartCommand}"/>
                  <Button Classes="danger" Content="Remove part" Command="{Binding RemoveCalcPartCommand}"/>
                </StackPanel>
                <TextBlock Classes="hint" Margin="0" Text="{Binding CalcCostText}" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <!-- Results -->
            <StackPanel Grid.Column="2" Spacing="16" VerticalAlignment="Top" MaxWidth="560" HorizontalAlignment="Left">
              <Border Classes="bar">
                <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding CalcSummary}" Foreground="{Binding CalcBelowGoal, Converter={x:Static vm:Converters.RedIfTrue}}"/>
              </Border>
              <Border Classes="card">
                <StackPanel Spacing="4">
                  <TextBlock Classes="h2" Text="One unit, normal sale"/>
                  <ItemsControl ItemsSource="{Binding CalcOrganic}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:CalcLine">
                        <Grid ColumnDefinitions="*,110" Margin="0,3">
                          <TextBlock Text="{Binding Name}" FontWeight="{Binding Bold, Converter={x:Static vm:Converters.BoldIfTrue}}"/>
                          <TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="{Binding Amount, StringFormat=N2}"
                                     FontWeight="{Binding Bold, Converter={x:Static vm:Converters.BoldIfTrue}}" Foreground="{Binding Amount, Converter={x:Static vm:Converters.NegativeRed}}"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <Border Classes="card">
                <StackPanel Spacing="4">
                  <TextBlock Classes="h2" Text="If the sale came through an Offsite Ad"/>
                  <ItemsControl ItemsSource="{Binding CalcWorst}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:CalcLine">
                        <Grid ColumnDefinitions="*,110" Margin="0,3">
                          <TextBlock Text="{Binding Name}" FontWeight="{Binding Bold, Converter={x:Static vm:Converters.BoldIfTrue}}"/>
                          <TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="{Binding Amount, StringFormat=N2}"
                                     FontWeight="{Binding Bold, Converter={x:Static vm:Converters.BoldIfTrue}}" Foreground="{Binding Amount, Converter={x:Static vm:Converters.NegativeRed}}"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <TextBlock Classes="hint" Margin="0" TextWrapping="Wrap" Text="Today's fee rates (Settings). Leaves out the 3% processing fee on sales tax, which depends on where the buyer lives."/>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
